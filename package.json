{
  "name": "todo-nexus",
  "displayName": "Todo Nexus",
  "description": "Your developer dashboard — TODO tracker and project notes in the sidebar.",
  "version": "1.0.0",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "publisher": "melvsanity",
  "repository": {
    "type": "git",
    "url": "https://github.com/Melvsanity/TodoNexus-extension.git"
  },
  "activationEvents": ["onStartupFinished"],
  "icon": "images/todonexus-icon.png",
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todonexus",
          "title": "Todo Nexus",
          "icon": "images/todonexus-icon.svg"
        }
      ]
    },
    "views": {
      "todonexus": [
        {
          "id": "todonexus.panel",
          "name": "Todo Nexus",
          "type": "webview",
          "icon": "images/todonexus-icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "todonexus.refresh",
        "title": "Refresh TODOs",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "todonexus.refresh",
          "when": "view == todonexus.panel",
          "group": "navigation"
        }
      ]
    }
  }
}