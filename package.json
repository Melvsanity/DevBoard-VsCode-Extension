{
  "name": "devboard",
  "displayName": "DevBoard",
  "description": "Your developer dashboard — TODO tracker, pinned files, and project notes in the sidebar.",
  "version": "1.0.0",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "publisher": "melvsanity",
  "repository": {
    "type": "git",
    "url": "https://github.com/Melvsanity/DevBoard-VsCode-Extension.git"
  },
  "activationEvents": ["onStartupFinished"],
  "icon": "images/devboard-extension-icon.png",
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devboard",
          "title": "DevBoard",
          "icon": "images/devboard-icon.svg"
        }
      ]
    },
    "views": {
      "devboard": [
        {
          "id": "devboard.panel",
          "name": "DevBoard",
          "type": "webview",
          "icon": "images/devboard-extension-icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "devboard.refresh",
        "title": "Refresh TODOs",
        "icon": "$(refresh)"
      },
      {
        "command": "devboard.pinFile",
        "title": "DevBoard: Pin File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devboard.refresh",
          "when": "view == devboard.panel",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "devboard.pinFile",
          "group": "navigation"
        }
      ]
    }
  }
}
